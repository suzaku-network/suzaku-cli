# Active monitor model (required; create a dedicated Moonshot key)
MOONSHOT_API_KEY=replace-me

# Optional automatic fallback. Production defaults to false; when false, do not
# install an Anthropic key on the VM. Enabling requires both values and a restart.
SUZAKU_ENABLE_ANTHROPIC_FALLBACK=false
ANTHROPIC_API_KEY=

# Telegram monitor bot and allowlist
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_ADMIN_USER_ID=123456789
TELEGRAM_GROUP_ID=-1001234567890
# Optional forum topic id. Leave empty to post in the General topic.
TELEGRAM_TOPIC_ID=

# Internal gateway authentication; generate with: openssl rand -hex 24
OPENCLAW_GATEWAY_TOKEN=replace-me

# Optional explorer acceleration for event scans
# Optional. Avalanche is not on Etherscan's free tier; Lite is currently the
# minimum supported plan. Leave empty to use the public Avalanche RPC path.
ETHERSCAN_API_KEY=
# Legacy compatibility only; prefer ETHERSCAN_API_KEY.
SNOWSCAN_API_KEY=

# Deployment controls. The default config is Kimi; Codex remains an explicit,
# inactive option at ./openclaw-codex.json.
SUZAKU_BOT_IMAGE=suzaku-monitor:local
SUZAKU_MONITOR_CONFIG=./openclaw.json
