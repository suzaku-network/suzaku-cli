            "startEpoch": "{{currentEpoch-1}}",
            "epochs": 1,
            "network": "mainnet"
          },
          "timeoutMs": 240000,
          "facts": [
            { "name": "uptimeData", "path": ["operators", "uptimes", "report"], "match": "exists", "answerMatch": false },
            { "name": "epochMentioned", "value": "{{currentEpoch-1}}", "match": "integer", "context": ["epoch"] }
          ]
        }
      ]
    },
    {
      "id": "wrapper-info",
      "prompt": "What does the wsALOT wrapper look like right now — share price and total assets?",
      "expectedTools": [["lst_wrapper_info"]],
      "maxToolCalls": 3,
      "groundTruth": [
        {
          "tool": "lst_wrapper_info",
