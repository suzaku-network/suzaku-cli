          ]
        },
        {
          "tool": "middleware_get_all_operators",
          "args": { "middlewareAddress": "{{middleware}}", "network": "mainnet" },
          "facts": [
            { "name": "operatorCount", "path": ["operators", "allOperators"], "match": "count", "context": ["operator", "operators"] }
          ]
        }
      ]
    },
    {
      "id": "linked-addresses",
      "prompt": "Which contracts make up the Dexalot deployment? List the linked addresses.",
      "expectedTools": [["middleware_get_linked_addresses"]],
      "forbiddenTools": ["discover_network"],
